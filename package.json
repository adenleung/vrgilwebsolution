{
  "name": "vrgil-web-solutions",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "audit:site": "node scripts/audit.mjs",
    "format": "prettier --write src tests scripts playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests scripts playwright.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
